# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# turborepo cache
.turbo/

# agent tooling (local only)
.agents/
.commandcode/
skills-lock.json

# generated: copied out of node_modules by scripts/copy-vendor.ts
/public/sandbox/vendor/

# staging area for curated Kenney sprites, uploaded to Supabase Storage
/assets-src/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
