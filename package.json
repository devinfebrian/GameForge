    "motion": "^13.3.0",
    "next": "16.3.4",
    "phaser": "^4.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
