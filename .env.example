# Supabase — Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails promoted to the admin role on sign-in.
ADMIN_EMAILS=

# Public origin of this app (auth redirects, sandbox iframe).
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# LLM access for the generation pipeline (/api/generate). Both are optional for
# the rest of the app: only generation fails without them.
#
# These point at an OpenAI-compatible gateway that fronts Claude, NOT at
# api.anthropic.com directly - the gateway returns 404 for /v1/messages. The
# credential is therefore sent as `Authorization: Bearer <token>`, so it is a
# gateway JWT rather than an `sk-ant-` key. See lib/llm/chat-completions.ts.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Added in later phases:
# INTEGRATION_ENCRYPTION_KEY=
#
# The sandbox frame is same-host, so there is no PARENT_ORIGIN or SANDBOX_ORIGIN:
# the parent's origin comes from NEXT_PUBLIC_APP_ORIGIN and the asset origin is
# derived from NEXT_PUBLIC_SUPABASE_URL.
