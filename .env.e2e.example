# End-to-end tests run against a dedicated Supabase project, never the linked
# project: they write real games and versions, and the dev server runs with the
# fake pipeline enabled. Copy this to .env.e2e.local and fill it in.
#
# The account below is created automatically by e2e/global-setup.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
E2E_USER_EMAIL=e2e@gameforge.test
E2E_USER_PASSWORD=
